        <mxCell id="e0" value="1. solicitarReserva(evento) →&lt;br&gt;9. mostrarReservaPendiente() ←&lt;br&gt;10. confirmarReserva() →&lt;br&gt;14. mostrarResultado() ←" style="endArrow=none;html=1;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="est" target="pan"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" value="2. crearReserva() →&lt;br&gt;8. reservaPendiente (10 min) ←&lt;br&gt;11. confirmar() →" style="endArrow=none;html=1;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="pan" target="ges"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="3. verificarCupo() →&lt;br&gt;6. hayCupo ←" style="endArrow=none;html=1;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="ges" target="cal"><mxGeometry relative="1" as="geometry" /></mxCell>
