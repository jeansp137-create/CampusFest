        <mxCell id="est" value="Estudiante" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1"><mxGeometry x="110" y="330" width="40" height="80" as="geometry" /></mxCell>
