        <mxCell id="e4" value="5. obtenerReservasVigentes() →" style="endArrow=none;html=1;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="cal" target="res"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="7. crear(estado = Pendiente) →&lt;br&gt;12. cambiarEstado(Confirmada) →&lt;br&gt;13. cambiarEstado(Vencida) si pasan 10 min o se cancela →" style="endArrow=none;html=1;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="ges" target="res"><mxGeometry relative="1" as="geometry" /></mxCell>
